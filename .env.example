# Azure OpenAI Realtime (GA) configuration
# Copy this file to .env and fill in your key.

# Full endpoint you were given (everything up to the host is used; the path/query is ignored).
AZURE_REALTIME_ENDPOINT=https://alisa-mf6l15pq-swedencentral.cognitiveservices.azure.com/openai/v1/realtime?model=gpt-realtime-2

# The deployment name (the `model` value in your endpoint URL).
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2

# Your Azure resource key.
AZURE_REALTIME_API_KEY=PUT_YOUR_KEY_HERE

# Voice for the agent: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
AGENT_VOICE=marin

# Transcription model for the *human's* speech (needed for the sentiment step later).
# Common options on Azure: whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe
INPUT_TRANSCRIPTION_MODEL=whisper-1

# --- Post-call sentiment analysis (a STANDARD chat deployment, not realtime) ---
# Deploy a chat model (e.g. gpt-4o / gpt-4.1) on the same Azure resource and put
# its DEPLOYMENT NAME here. Reuses AZURE_REALTIME_API_KEY + the resource above.
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_CHAT_API_VERSION=2024-10-21
